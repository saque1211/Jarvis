# ─── JARVIS ────────────────────────────────────────────────────────────────
# Copie pra .env e preencha. Só uma chave de LLM é obrigatória pra começar.

# Como ele se chama. Aparece no que ele fala, no HUD e nas notificações.
# As variáveis abaixo continuam com prefixo JARVIS_ de propósito: renomeá-las
# quebraria todo .env já escrito, sem avisar.
# JARVIS_NOME=VEXIS

# ─── Cérebro (obrigatório: uma das três) ───────────────────────────────────

# Groq — free tier, bem rápido. Chave em https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic — roteia melhor com 99 tools, mas é pago.
ANTHROPIC_API_KEY=

# OpenAI — barato por token, mas não tem free tier: precisa de crédito na
# conta pra qualquer chamada funcionar. Chave em platform.openai.com/api-keys
OPENAI_API_KEY=

# Qual usar. Vazio = o grátis primeiro (Groq se houver chave), senão o que tiver.
# LLM_PROVIDER=groq

# Endpoint compatível com /chat/completions da OpenAI. Serve pra apontar num
# proxy local (Ollama, LM Studio, LiteLLM) ou noutro provedor que fale o mesmo
# protocolo — aí basta LLM_PROVIDER=openai e o modelo de lá em JARVIS_MODEL.
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#
# A Responses API (/v1/responses) NÃO é usada, de propósito: é outro protocolo
# (`input` no lugar de `messages`) e não muda nada aqui — as 99 tools vão
# inteiras na requisição dos dois jeitos, e o cache de prefixo da OpenAI é
# automático nos dois. Seria um adapter novo pra ganhar zero.

# Modelo do roteador — o que escolhe e chama as tools. Vazio = padrão:
#   groq      → llama-3.3-70b-versatile
#   openai    → gpt-4.1-mini
#   anthropic → claude-haiku-4-5   (o mais barato: $1/$5 por milhão de tokens)
#
# Na Anthropic, com o cache de prompt ligado, o custo por comando fica assim:
#   claude-haiku-4-5   ~$0,014 o primeiro comando, ~$0,004 os seguintes
#   claude-sonnet-5    ~3x isso, mas erra bem menos na escolha entre 99 tools
# Se ele começar a chamar a ferramenta errada, é aqui que se resolve.
# JARVIS_MODEL=claude-sonnet-5

# Modelo das etapas que são classificação, não raciocínio (hoje: escolher
# quais skills o comando precisa). Vazio = padrão:
#   groq      → llama-3.1-8b-instant
#   openai    → gpt-4.1-nano
#   anthropic → claude-haiku-4-5
# JARVIS_FAST_MODEL=

# Raciocínio do modelo. Escolher entre 99 tools é classificação, não raciocínio
# — então o padrão desliga o "thinking" e pede esforço baixo nos modelos que
# aceitam. Isso corta token de saída, que é a parte cara da conta. Ligue com 1
# se ele começar a errar comandos encadeados; a resposta melhora e o custo sobe.
# JARVIS_THINKING=1

# Quantas rodadas de tool-use antes de desistir de um comando.
JARVIS_MAX_TURNS=8

# Quando uma tool marcada com `speaks` resolve o comando sozinha, responde com
# a saída dela em vez de gastar outra ida ao modelo pra reescrever a frase.
# Corta ~1 viagem por comando. Desligue com 0 se quiser tudo redigido pelo LLM.
# JARVIS_FAST_REPLY=1

# Teto de tokens gasto só com definição de tool. As 99 tools custam ~14 mil —
# acima do teto, o router faz uma chamada barata antes pra escolher só as
# skills relevantes. Padrão: 3000 no Groq (free tier dá 12 mil/min), 0 na
# Anthropic (0 = manda tudo). Se tomar erro de limite, baixe.
# JARVIS_TOOL_BUDGET=3000

# ─── Voz ───────────────────────────────────────────────────────────────────
VOICE_ENABLED=true
JARVIS_SPEAK=true

# Wake word. Chave grátis em https://console.picovoice.ai
# O que faz o JARVIS começar a ouvir:
#   hotkey    tecla global (padrão sem chave). Funciona com o terminal atrás.
#   enter     Enter no terminal. Zero dependência, mas precisa de foco.
#   wakeword  falar "jarvis". Precisa da chave da Picovoice abaixo.
# Vazio = wakeword se houver chave, senão hotkey.
# JARVIS_TRIGGER=hotkey

# Tecla do modo hotkey. Combine com +: "ctrl+alt+j", "shift+space", "f9".
# JARVIS_HOTKEY=ctrl+alt+j

# Só pro modo wakeword. O cadastro da Picovoice exige e-mail corporativo —
# se você não tem um, fique no hotkey, que faz a mesma coisa sem chave.
PICOVOICE_ACCESS_KEY=

# "jarvis" já vem embutido no Porcupine. Outras built-in: computer, jarvis,
# alexa, bumblebee, picovoice, porcupine, terminator.
JARVIS_WAKE_WORD=jarvis
JARVIS_WAKE_SENSITIVITY=0.6

# Se você treinar uma wake word própria no console da Picovoice, aponte o .ppn:
# JARVIS_WAKE_WORD_PATH=C:/jarvis/wake/meu-jarvis.ppn

# Silêncio (ms) que encerra a captura do comando depois da wake word.
# Silêncio que encerra a captura depois que você para de falar.
JARVIS_SILENCE_MS=1000

# Piso de gravação: antes disso, silêncio nenhum encerra. Protege a pausa que
# todo mundo faz depois das duas primeiras palavras.
JARVIS_MIN_COMMAND_MS=1500

# Mostra energia, chiado e limiar frame a frame durante a captura. Ligue quando
# ele não estiver achando a hora de parar.
# JARVIS_VAD_DEBUG=1
JARVIS_MAX_COMMAND_MS=15000

# Índice do microfone (-1 = padrão do sistema).
JARVIS_MIC_INDEX=-1

# STT local. Deixe vazio pra autodetectar whisper.cpp (whisper-cli) ou o
# pacote Python openai-whisper. {file} é substituído pelo .wav gravado.
# STT_COMMAND=

# Alternativa ao STT_COMMAND: whisper.cpp em modo servidor. Mesma qualidade,
# mas o modelo fica carregado entre um comando e outro em vez de subir do disco
# toda vez. Suba com `npm run whisper:server` num terminal separado.
# STT_SERVER_URL=http://127.0.0.1:8080

# Vocabulário EXTRA que o whisper deve esperar ouvir, além do que o JARVIS já
# monta sozinho (verbos de comando + os nomes dos seus apps em config/apps.json).
# Ponha aqui o que é só seu: nomes de projeto, apelidos, gente, jogos.
# Ele não obriga nada — serve de desempate quando o áudio é ambíguo.
# STT_PROMPT=Workana, Fiverr, Godot, Blender, nome do seu projeto.

# Exemplo de STT_COMMAND com whisper.cpp instalado à mão:
# STT_COMMAND=whisper-cli -m C:/models/ggml-medium.bin -f {file} -l pt -nt --no-prints

# Tamanho do modelo do whisper. É a alavanca que mais muda a transcrição:
#   tiny    rápido e erra muito — não use em português
#   base    padrão. Erra nomes próprios e palavra técnica
#   small   bem melhor em pt-BR, ainda leve
#   medium  o ponto de equilíbrio pra voz em português
#   large   melhor de todos, pesado
# Com whisper.cpp isto é o CAMINHO do .bin; com o whisper do Python é o nome.
WHISPER_MODEL=base

# TTS. Vazio = SAPI, a voz nativa do Windows (funciona sem instalar nada).
# Pra Piper (bem melhor), use {text} e {out}:
# TTS_COMMAND=

# Vozes neurais da Microsoft — as mesmas do "ler em voz alta" do Edge.
# Grátis, sem cadastro, sem chave, e em português soam quase humanas.
# Ouça todas com `npm run voices:edge` e escolha.
# Precisa de internet; sem ela a fala cai no TTS local sozinha.
# EDGE_TTS_VOICE=pt-BR-AntonioNeural
# EDGE_TTS_RATE=+0%
# EDGE_TTS_VOLUME=+0%

# ElevenLabs — a voz mais natural que existe em pt-BR. É paga e tem prioridade
# sobre as outras: falhando (cota do mês, rede, chave), a fala cai pro próximo
# provedor sozinha, então acabar a cota não deixa o VEXIS mudo.
#
# Chave em elevenlabs.io → Profile → API Keys.
# Ouça as vozes e pegue o ID com: npm run voices:eleven -- --ouvir
#
# Custo no uso típico (~50 comandos/dia, 100 caracteres por resposta):
#   ~150 mil caracteres/mês → plano Creator, ~$22/mês
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
#
# Modelo. flash_v2_5 é o de menor latência e fala português; multilingual_v2
# soa um pouco melhor e demora um pouco mais. Num assistente de voz, meio
# segundo a mais incomoda mais que a diferença de qualidade.
# ELEVENLABS_MODEL=eleven_flash_v2_5
#
# 0 = expressiva e imprevisível, 1 = monótona e constante. Assistente quer
# previsibilidade: a mesma frase deve soar igual toda vez.
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.75
# ELEVENLABS_STYLE=0

# Fish Audio — voz na nuvem, qualidade acima de qualquer TTS local.
# O reference_id é o que aparece na página da voz em fish.audio.
# Ligado, ele tem prioridade; se a API falhar, cai no TTS local sozinho.
# Custo: cada fala é uma ida à rede, e o texto da resposta sai da sua máquina.
# (O áudio do microfone continua nunca saindo.)
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_VOICE_ID=
# FISH_AUDIO_MODEL=s1

# Voz do Windows. Um pedaço do nome basta: "maria", "daniel", "helena".
# Veja e ouça as instaladas com `npm run voices`.
# JARVIS_VOICE=maria
# JARVIS_VOICE_RATE=1        # -10 (devagar) a 10 (rápido)
# JARVIS_VOICE_VOLUME=100    # 0 a 100

# Som que toca quando um timer vence. O padrão é um beep de console — corta
# bem, mas é agressivo pra uma coisa que dispara várias vezes ao dia.
#   beep       o padrão
#   off        silencioso, fica só a notificação do Windows
#   alarme     o que vem em assets/sons do projeto
#   Alarm03    um .wav de C:/Windows/Media (ouça todos com: npm run sons)
#   C:/sons/meu.wav   qualquer arquivo seu (.wav ou .mp3)
# JARVIS_TIMER_SOM=alarme

# Onde a fala sai. "local" = placa de som do PC. "phone" = serve por HTTP e o
# navegador do celular toca (caixa de som quebrada, ouvir de outro cômodo, fone
# no celular). Sem ninguém com a página aberta, volta pro PC sozinho.
# JARVIS_SPEAKER=phone
# JARVIS_SPEAKER_PORT=8790

# Exemplo de TTS_COMMAND com o Piper instalado à mão:
# TTS_COMMAND=piper --model C:/piper/pt_BR-faber-medium.onnx --output_file {out}

# ─── Memória ───────────────────────────────────────────────────────────────
# VAULT_PATH=C:/Users/voce/Documents/vault

# ─── Segurança ─────────────────────────────────────────────────────────────
# Pastas onde o JARVIS pode mexer em arquivos, além da sua home e da raiz do
# projeto. Separadas por vírgula.
# JARVIS_ALLOWED_ROOTS=D:/Projetos,E:/Midia

# Exigir confirmação antes de comandos destrutivos. Deixe true.
JARVIS_CONFIRM_DESTRUCTIVE=true
JARVIS_COMMAND_TIMEOUT_MS=120000

# Onde ficam prints e gravações.
# JARVIS_CAPTURE_DIR=C:/Users/voce/Pictures/Jarvis

# Onde ficam seus projetos (usado por scaffold e build).
# JARVIS_PROJECTS_DIR=C:/Users/voce/Projects

# ─── Integrações ───────────────────────────────────────────────────────────

# Spotify — https://developer.spotify.com/dashboard
# Cadastre o Redirect URI: http://127.0.0.1:8888/callback
# Depois rode: npm run auth:spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# GitHub — token clássico com escopo repo + workflow
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=saque1211/Jarvis

# Discord — Config do canal > Integrações > Webhooks
DISCORD_WEBHOOK_URL=

# Casa inteligente via Home Assistant
# HOME_ASSISTANT_URL=http://192.168.0.10:8123
# HOME_ASSISTANT_TOKEN=

# Busca web — grátis até 2000 consultas/mês em brave.com/search/api
BRAVE_API_KEY=

# Freelance — feeds RSS separados por vírgula. Veja .skills/freelance.md
# FREELANCE_FEEDS=https://www.workana.com/jobs/rss?category=it-programming&language=pt
# WORKANA_COOKIE=

# Quanto do log de hoje entra no system prompt de cada chamada. O log só cresce
# ao longo do dia — teto curto evita que o custo por comando suba junto e
# estoure o limite por minuto do provedor. O modelo busca o resto pela skill
# memory quando precisa.
JARVIS_VAULT_CONTEXT=1200

# Quantas skills a pré-seleção pode escolher. Cada uma a mais leva as tools
# dela em toda chamada do loop. Duas cobrem quase todo comando.
JARVIS_MAX_SKILLS=2
