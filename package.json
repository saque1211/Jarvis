{
  "name": "jarvis-os",
  "version": "0.2.0",
  "description": "Assistente pessoal voice-first para Windows 11. Wake word local, roteamento por Claude, controle real da maquina.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "jarvis": "node src/index.js",
    "listen": "node src/voice/daemon.js",
    "doctor": "node scripts/doctor.js",
    "hud:state": "node scripts/hud-state.js",
    "auth:spotify": "node scripts/auth-spotify.js"
  },
  "keywords": [
    "jarvis",
    "voice-assistant",
    "claude",
    "wake-word",
    "windows"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "dotenv": "^16.4.5",
    "groq-sdk": "^0.9.1",
    "picocolors": "^1.1.1"
  },
  "optionalDependencies": {
    "@picovoice/porcupine-node": "^3.0.3",
    "@picovoice/pvrecorder-node": "^1.2.2"
  }
}
