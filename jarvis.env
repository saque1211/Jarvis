# Configuracao do cliente de voz (pi/jarvis-pi.py).
#
# Isto e lido automaticamente pelo jarvis-pi.py — no Windows, no lugar do
# /etc/jarvis.env que so existe no Linux. Assim voce nao precisa digitar
# variavel nenhuma no PowerShell: e so rodar `python pi/jarvis-pi.py` (ou dar
# duplo-clique no iniciar-vexis.bat).

# Onde esta o seu servidor. Troque o IP se ele mudar.
JARVIS_NUCLEUS_URL=http://163.245.213.167:3000
JARVIS_CLOUD_URL=http://163.245.213.167:8080

# Como ele comeca a ouvir: "escuta" = microfone aberto ouvindo a palavra "vexis".
JARVIS_TRIGGER=escuta

# Sensibilidade do "vexis" (0 a 1). Um modelo treinado por voce pontua mais
# baixo que os de fabrica, entao o padrao (0.5) quase nunca dispara — 0.1 e um
# bom ponto de partida.
#   - Se ele NAO te ouve: baixe (0.08, 0.05).
#   - Se dispara sozinho no silencio: suba (0.15, 0.2).
WAKE_LIMIAR=0.1

# Descomente pra ver, no terminal, o nivel do microfone e a pontuacao a cada
# fala — util pra calibrar o WAKE_LIMIAR. Deixe comentado no uso normal.
# WAKE_DEBUG=1

# Microfone. O [1] (USB Audio Device) e o que capta bem nesta maquina. Se um dia
# parar de ouvir (nivel do mic: 0), rode `python pi/testar-mic.py` pra achar o
# numero novo (indices de USB mudam quando voce troca de porta) e ajuste aqui.
JARVIS_MIC=1
